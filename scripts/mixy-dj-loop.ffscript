st(7,2.2*sin(2*ld(0))*ld(1)+1.0*sin(2*ld(0)+0.30)*ld(4)+1.0*sin(2*ld(0)-0.30)*ld(5));
st(8,(1-ld(1))*exp(-pow((Y/H-0.36)/0.48,4)));
st(9,1.8*sin(ld(0)+PI)*ld(8));
st(10,(1-exp(-pow((X/W-0.50)/0.28,4)))*exp(-pow((Y/H-0.38)/0.43,4)));
st(11,exp(-pow((Y/H-0.72)/0.16,4)));
clip(lum(X-ld(6)-ld(9),Y-ld(7))*(1+0.055*sin(4*ld(0)+Y/H*18)*ld(10)+0.035*sin(6*ld(0)+X/W*24)*ld(11)),0,255)':
cb='
st(0,2*PI*T/4);
st(1,exp(-pow((X/W-0.50)/0.28,4)-pow((Y/H-0.35)/0.40,4))/(1+exp((Y/H-0.64)/0.025)));
st(2,exp(-pow((X/W-0.31)/0.16,2)-pow((Y/H-0.25)/0.28,2)));
st(3,exp(-pow((X/W-0.69)/0.16,2)-pow((Y/H-0.25)/0.28,2)));
st(4,exp(-pow((X/W-0.25)/0.11,2)-pow((Y/H-0.63)/0.10,2)));
st(5,exp(-pow((X/W-0.75)/0.11,2)-pow((Y/H-0.63)/0.10,2)));
st(6,2.4*sin(ld(0))*ld(1)+2.2*sin(ld(0)-0.45)*ld(2)+2.2*sin(ld(0)+0.45)*ld(3)+1.2*sin(ld(0)+0.25)*ld(4)-1.2*sin(ld(0)-0.25)*ld(5));
st(7,2.2*sin(2*ld(0))*ld(1)+1.0*sin(2*ld(0)+0.30)*ld(4)+1.0*sin(2*ld(0)-0.30)*ld(5));
st(8,(1-ld(1))*exp(-pow((Y/H-0.36)/0.48,4)));
st(9,1.8*sin(ld(0)+PI)*ld(8));
cb(X-ld(6)-ld(9),Y-ld(7))':
cr='
st(0,2*PI*T/4);
st(1,exp(-pow((X/W-0.50)/0.28,4)-pow((Y/H-0.35)/0.40,4))/(1+exp((Y/H-0.64)/0.025)));
st(2,exp(-pow((X/W-0.31)/0.16,2)-pow((Y/H-0.25)/0.28,2)));
st(3,exp(-pow((X/W-0.69)/0.16,2)-pow((Y/H-0.25)/0.28,2)));
